# ============================================
# Social Enterprise Platform - Backend Config
# ============================================

# App
APP_PORT=4000
APP_ENV=development

# Reverse proxy. Set to the number of trusted proxy hops (usually 1) ONLY when
# the API sits behind nginx/a load balancer. When unset, X-Forwarded-For is
# ignored so a client cannot forge its IP to evade rate limiting or poison the
# audit log. Leave empty for direct/local runs.
TRUST_PROXY=

# Database (PostgreSQL - Digital Ocean Managed)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bep_se
DB_SSL=false
# Certificate validation is ON by default (secure by default). Set to false
# ONLY for managed DBs whose CA chain your host does not yet trust — and fix
# that properly by installing the provider's CA instead of leaving it false.
DB_SSL_REJECT_UNAUTHORIZED=
# Path to the CA certificate file (relative to backend/). Required when
# DB_SSL=true and the DB provider uses a self-signed CA (e.g. DigitalOcean).
# The file must be in PEM format (-----BEGIN CERTIFICATE----- ... END CERTIFICATE-----).
DB_CA_CERT=

# JWT — generate with: openssl rand -hex 64. The app refuses to boot with
# missing/short/placeholder secrets.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Session cookie Secure flag. Unset = automatic (on when APP_ENV=production).
# Set true to force HTTPS-only cookies on staging/preview deploys behind TLS.
COOKIE_SECURE=

# S3 Compatible Storage (Digital Ocean Spaces)
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=bep-se-uploads
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# CORS
CORS_ORIGIN=http://localhost:3000

# Locally-stored uploads are served via HMAC-signed, expiring URLs
# (/api/uploads/...). Signing key defaults to a hash derived from JWT_SECRET;
# set a dedicated random value here to decouple them.
UPLOAD_URL_SECRET=
# Signed URL validity in seconds (default 30 days).
UPLOAD_URL_TTL_SECONDS=2592000
# Migration grace: when true, unsigned legacy URLs stored before signing was
# introduced are still served. Defaults to FALSE — only signed URLs (or
# authenticated sessions) work. Enable temporarily only while migrating.
UPLOADS_ALLOW_UNSIGNED=false

# Password used by `npm run seed` for the initial admin@bep.org account.
# REQUIRED — seeding aborts without it. Must satisfy the password policy
# (8+ chars, upper + lower + digit). Generate with: openssl rand -base64 18
SEED_ADMIN_PASSWORD=

# WebAuthn / Passkeys
# RP ID must be the site's effective domain (no scheme/port), e.g. `localhost`
# in development or `app.example.com` in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=BEP Social Enterprise Platform
# Full origin(s) of the frontend, comma-separated. Defaults to CORS_ORIGIN.
WEBAUTHN_ORIGIN=http://localhost:3000
