# ============================================
# Social Enterprise Platform - Backend Config
# ============================================

# App
APP_PORT=4000
APP_ENV=development

# Reverse proxy. Set to the number of trusted proxy hops (usually 1) ONLY when
# the API sits behind nginx/a load balancer. When unset, X-Forwarded-For is
# ignored so a client cannot forge its IP to evade rate limiting or poison the
# audit log. Leave empty for direct/local runs.
TRUST_PROXY=

# Database (PostgreSQL - Digital Ocean Managed)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bep_se
DB_SSL=false
# For managed DBs using custom CA chains (e.g., DigitalOcean), set this false.
# Set to true only when your server trusts the DB CA certificate chain.
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# S3 Compatible Storage (Digital Ocean Spaces)
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=bep-se-uploads
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# CORS
CORS_ORIGIN=http://localhost:3000

# Password used by `npm run seed` for the initial admin@bep.org account.
# Must satisfy the password policy (8+ chars, upper + lower + digit).
SEED_ADMIN_PASSWORD=ChangeMe#2024

# WebAuthn / Passkeys
# RP ID must be the site's effective domain (no scheme/port), e.g. `localhost`
# in development or `app.example.com` in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=BEP Social Enterprise Platform
# Full origin(s) of the frontend, comma-separated. Defaults to CORS_ORIGIN.
WEBAUTHN_ORIGIN=http://localhost:3000
